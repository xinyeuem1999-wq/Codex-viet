# Gộp tối ưu bởi patchx: Tiện-ích

[MIN_ENGINE_VER]
2

[AUTHOR]
HTC 600

[PACKAGE]
*

[ADD_FILES]
TARGET:
    smali
EXTRACT:
    true
SOURCE:
    BiN.zip
[/ADD_FILES]

[MATCH_REPLACE]
TARGET:
    smali/cc/binmt/signature/PmsHookApplication.smali
MATCH:
    ### Installer ###
REGEX:
    true
REPLACE:
    com.amazon
[/MATCH_REPLACE]

[MATCH_GOTO]
TARGET:
    AndroidManifest.xml
MATCH:
    <application(.+)android:name=
REGEX:
    true
GOTO:
    p0_app1
[/MATCH_GOTO]

[MATCH_REPLACE]
TARGET:
    AndroidManifest.xml
MATCH:
    <application(.+)>
REGEX:
    true
REPLACE:
    <application${GROUP1} android:name="cc.binmt.signature.PmsHookApplication">
[/MATCH_REPLACE]

[GOTO]
GOTO:
    p0_end
[/GOTO]

[MATCH_REPLACE]
NAME:
    p0_app1
TARGET:
    AndroidManifest.xml
MATCH:
    <application (.+) android:name="([^"]+)"(.+)
REGEX:
    true
REPLACE:
    <application ${GROUP1} android:name="cc.binmt.signature.PmsHookApplication"${GROUP3}
[/MATCH_REPLACE]

[MATCH_ASSIGN]
TARGET:
    [APPLICATION]
MATCH:
    \.class (.+?)L(.+);
REGEX:
    true
ASSIGN:
    LABEL_1=L${GROUP2};
[/MATCH_ASSIGN]

[MATCH_REPLACE]
TARGET:
    [APPLICATION]
MATCH:
    \.class public (|.+)L(.+);
REGEX:
    true
REPLACE:
    .class public L${GROUP2};
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    smali/cc/binmt/signature/PmsHookApplication.smali
MATCH:
    Landroid/app/Application;
REGEX:
    false
REPLACE:
    ${LABEL_1}
[/MATCH_REPLACE]

[EXECUTE_DEX]
NAME:
    p0_end
SCRIPT:
    sigfix.dex
SMALI_NEEDED:
    true
MAIN_CLASS:
    anymy.BinSignatureFix
ENTRANCE:
    BinSignatureFix
PARAM:
    smali
[/EXECUTE_DEX]

[DUMMY]
NAME:
    p0_end2
[/DUMMY]

[MATCH_REPLACE]
TARGET:
    AndroidManifest.xml
MATCH:
    <application
REGEX:
    false
REPLACE:
    <uses-permission android:name="android.permission.CAMERA" />
<application
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    \.method (.+) onCreate\(Landroid/os/Bundle;\)V\n    \.registers (\d+)
REGEX:
    true
REPLACE:
    .method ${GROUP1} onCreate(Landroid/os/Bundle;)V
    .registers ${GROUP2}

    invoke-virtual {p0}, xxx111xxx->isCameraPermission()Z
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    \# virtual methods
REGEX:
    true
REPLACE:
    # virtual methods
.method public isCameraPermission()Z
    .registers 5

    const/4 v3, 0x1

    const/4 v2, 0x0

    sget v0, Landroid/os/Build$VERSION;->SDK_INT:I

    const/16 v1, 0x17

    if-lt v0, v1, :cond_10

    const-string v0, "android.permission.CAMERA"

    invoke-virtual {p0, v0}, xxx111xxx->checkSelfPermission(Ljava/lang/String;)I

    move-result v0

    if-nez v0, :cond_11

    :cond_10
    :goto_10
    return v2

    :cond_11
    new-array v0, v3, [Ljava/lang/String;

    const-string v1, "android.permission.CAMERA"

    aput-object v1, v0, v2

    invoke-static {p0, v0, v3}, Landroid/support/v4/app/ActivityCompat;->requestPermissions(Landroid/app/Activity;[Ljava/lang/String;I)V

    goto :goto_10
.end method
[/MATCH_REPLACE]

[MATCH_ASSIGN]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    \.class public (.+)
REGEX:
    true
ASSIGN:
    LABEL_1=${GROUP1}
[/MATCH_ASSIGN]

[MATCH_REPLACE]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    xxx111xxx
REGEX:
    false
REPLACE:
    ${LABEL_1}
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    iget-object ([pv]\d+), ([pv]\d+), Landroid/content/pm/PackageInfo;->signatures:\[Landroid/content/pm/Signature;
REGEX:
    true
REPLACE:
    invoke-static {${GROUP2}}, Lapkeditor/patch/signature/Fix;->getSignatures(Landroid/content/pm/PackageInfo;)[Landroid/content/pm/Signature;
    move-result-object ${GROUP1}
[/MATCH_REPLACE]

[ADD_FILES]
SOURCE:
    Fix.smali
TARGET:
    smali/apkeditor/patch/signature/Fix.smali
[/ADD_FILES]

[SIGNATURE_REVISE]
TARGET:
    smali/apkeditor/patch/signature/Fix.smali
[/SIGNATURE_REVISE]

[MATCH_REPLACE]
TARGET:
    smali*/*smali
MATCH:
    const-string ([pv]\d+), ".+"\n\n    invoke-static \{([pv]\d+), ([pv]\d+)\}, Lcom/google/android/getGPS;->checkGPS\(Landroid/content/Context;Ljava/lang/String;\)V
REGEX:
    true
REPLACE:
    #  HTC 600 - ubivaet :-)
[/MATCH_REPLACE]

