# Gộp tối ưu bởi patchx: Khác

[MIN_ENGINE_VER]
2

[AUTHOR]
HTC 600

[PACKAGE]
*

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    invoke-virtual \{([pv]\d+), ([pv]\d+)\}, Ljava/security/Signature;->verify\(\[B\)Z\n\n    move-result ([pv]\d+)
REGEX:
    true
REPLACE:
    invoke-virtual {${GROUP1}, ${GROUP2}}, Ljava/security/Signature;->verify([B)Z

    const/4 ${GROUP3}, 0x1
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    const-string ([pv]\d+), "APPLICATION_LICENSE"\n\n    invoke-virtual \{([pv]\d+), ([pv]\d+)\}, (.+)\n\n    move-result ([pv]\d+)\n\n    if-eqz ([pv]\d+), :cond_(.+)
REGEX:
    true
REPLACE:
    const-string ${GROUP1}, "APPLICATION_LICENSE"

    invoke-virtual {${GROUP2}, ${GROUP3}}, ${GROUP4}

    const/4 ${GROUP5}, 0x1

    if-eqz ${GROUP6}, :cond_${GROUP7}
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    AndroidManifest.xml
MATCH:
    <application
REGEX:
    false
REPLACE:
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
<application
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    \.method (.+) onCreate\(Landroid/os/Bundle;\)V\n    \.registers (\d+)
REGEX:
    true
REPLACE:
    .method ${GROUP1} onCreate(Landroid/os/Bundle;)V
    .registers ${GROUP2}

    invoke-virtual {p0}, xxx111xxx->isPhonePermission()Z
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    \# virtual methods
REGEX:
    true
REPLACE:
    # virtual methods
.method public isPhonePermission()Z
    .registers 5

    const/4 v3, 0x1

    const/4 v2, 0x0

    sget v0, Landroid/os/Build$VERSION;->SDK_INT:I

    const/16 v1, 0x17

    if-lt v0, v1, :cond_10

    const-string v0, "android.permission.READ_PHONE_STATE"

    invoke-virtual {p0, v0}, xxx111xxx->checkSelfPermission(Ljava/lang/String;)I

    move-result v0

    if-nez v0, :cond_11

    :cond_10
    :goto_10
    return v2

    :cond_11
    new-array v0, v3, [Ljava/lang/String;

    const-string v1, "android.permission.READ_PHONE_STATE"

    aput-object v1, v0, v2

    invoke-static {p0, v0, v3}, Landroid/support/v4/app/ActivityCompat;->requestPermissions(Landroid/app/Activity;[Ljava/lang/String;I)V

    goto :goto_10
.end method
[/MATCH_REPLACE]

[MATCH_ASSIGN]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    \.class public (.+)
REGEX:
    true
ASSIGN:
    LABEL_1=${GROUP1}
[/MATCH_ASSIGN]

[MATCH_REPLACE]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    xxx111xxx
REGEX:
    false
REPLACE:
    ${LABEL_1}
[/MATCH_REPLACE]
