# Combo tự phát hiện: shell (5 patch)

[MIN_ENGINE_VER]
3

[AUTHOR]
Anymy

[PACKAGE]
*

[MATCH_REPLACE]
TARGET:
    smali*/*
MATCH:
    invoke-virtual \{([vp]\d+), ([vp]\d+), ([vp]\d+)\}, Ljava\/lang\/reflect\/Method;->invoke\(Ljava\/lang\/Object;\[Ljava\/lang\/Object;\)Ljava\/lang\/Object;
REGEX:
    true
REPLACE:
    invoke-static {${GROUP1}, ${GROUP2}, ${GROUP3}}, Lcom/anymy/ref;->invoke(Ljava/lang/Object;Ljava/lang/Object;[Ljava/lang/Object;)V

invoke-virtual {${GROUP1}, ${GROUP2}, ${GROUP3}}, Ljava/lang/reflect/Method;->invoke(Ljava/lang/Object;[Ljava/lang/Object;)Ljava/lang/Object;
[/MATCH_REPLACE]

