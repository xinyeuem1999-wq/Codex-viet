# Combo: Bypass-VIP/License+Quét-Token (1 patch)

[MIN_ENGINE_VER]
2

[AUTHOR]
HTC 600 and angel

[PACKAGE]
ALL

[ADD_FILES]
SOURCE:
    libfrida-gadget.so
TARGET:
    lib/armeabi-v7a/libfrida-gadget.so
[/ADD_FILES]

[MATCH_GOTO]
TARGET:
    smali*/*.smali
MATCH:
    c3RhcnQgbWFnaWMh
REGEX:
    true
GOTO:
    end
[/MATCH_GOTO]

[ADD_FILES]
SOURCE:
    smali.zip
TARGET:
    smali
EXTRACT:
    true
[/ADD_FILES]

[SIGNATURE_REVISE]
TARGET:
    smali/com/frida/Fix.smali
[/SIGNATURE_REVISE]

[MATCH_GOTO]
TARGET:
    [APPLICATION]
MATCH:
    \.method (.+) onCreate\((.+|)\)V\n    \.(registers) ([0-9]+)
REGEX:
    true
GOTO:
    add_application1
[/MATCH_GOTO]

[MATCH_GOTO]
TARGET:
    smali*/*.smali
MATCH:
    invoke-super (.+), Landroid\/app\/Application;->onCreate(.+)
REGEX:
    true
GOTO:
    add_application2
[/MATCH_GOTO]

[MATCH_GOTO]
TARGET:
    smali/com/unity3d/player/UnityPlayerActivity.smali
MATCH:
    \.method (.+) onCreate\((.+|)\)V\n    \.(registers) ([0-9]+)
REGEX:
    true
GOTO:
    add_unity
[/MATCH_GOTO]

[MATCH_REPLACE]
NAME:
    add_activities
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    \.method (.+) <init>\((.+|)\)V\n    \.(registers) (\d+)
REGEX:
    true
REPLACE:
    .method ${GROUP1} <init>(${GROUP2})V
    .${GROUP3} ${GROUP4}

    invoke-static {}, Lcom/frida/injector;->startE()V
[/MATCH_REPLACE]

[GOTO]
GOTO:
    final
[/GOTO]

[MATCH_REPLACE]
NAME:
    add_unity
TARGET:
    smali/com/unity3d/player/UnityPlayerActivity.smali
MATCH:
    \.method (.+) onCreate\((.+|)\)V\n    \.(registers) (\d+)
REGEX:
    true
REPLACE:
    .method ${GROUP1} onCreate(${GROUP2})V
    .${GROUP3} ${GROUP4}

    invoke-static {}, Lcom/frida/injector;->startE()V
[/MATCH_REPLACE]

[MATCH_REPLACE]
NAME:
    add_application1
TARGET:
    [APPLICATION]
MATCH:
    \.method (.+) onCreate\((.+|)\)V\n    \.(registers) (\d+)
REGEX:
    true
REPLACE:
    .method ${GROUP1} onCreate(${GROUP2})V
    .${GROUP3} ${GROUP4}

    invoke-static {}, Lcom/frida/injector;->startE()V
[/MATCH_REPLACE]

[MATCH_REPLACE]
NAME:
    add_application2
TARGET:
    smali*/*.smali
MATCH:
    invoke-super (.+), Landroid\/app\/Application;->onCreate(.+)
REGEX:
    true
REPLACE:
    invoke-static {}, Lcom/frida/injector;->startE()V
	
	invoke-super ${GROUP1}, Landroid/app/Application;->onCreate${GROUP2}
[/MATCH_REPLACE]

[MATCH_REPLACE]
NAME:
    final
TARGET:
    smali/com/frida/injector.smali
MATCH:
    "FRIDA_E_SCRIPT"
REGEX:
    true
REPLACE:
    ""
[/MATCH_REPLACE]

[DUMMY]
NAME:
    end
[/DUMMY]
