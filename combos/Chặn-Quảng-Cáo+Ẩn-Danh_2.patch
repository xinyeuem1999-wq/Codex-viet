[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    iget-object ([pv]\d+), ([pv]\d+), L(\S+);->ip:Ljava/lang/String;
REGEX:
    true
REPLACE:
    const-string ${GROUP1}, "255.255.255.255"
