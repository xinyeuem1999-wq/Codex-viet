[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    invoke-virtual \{([pv]\d+)\}, Landroid/location/Location;->getLatitude\(\)D\n\n    move-result-wide ([pv]\d+)
REGEX:
    true
REPLACE:
    invoke-static {}, Lcom/htc/htc600/htc600for4pda/generatE;->MaccID()D

    move-result-wide ${GROUP2}
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    invoke-virtual \{([pv]\d+)\}, Landroid/location/Location;->getLongitude\(\)D\n\n    move-result-wide ([pv]\d+)
REGEX:
    true
REPLACE:
    invoke-static {}, Lcom/htc/htc600/htc600for4pda/generatE;->MaccID()D

    move-result-wide ${GROUP2}
[/MATCH_REPLACE]

[ADD_FILES]
TARGET:
    smali/com/htc/htc600/htc600for4pda/AndroidID.smali
