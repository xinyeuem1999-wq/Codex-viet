    true
REPLACE:
    .method public static${GROUP1}(Landroid/content/Context;)I
    .registers 1
    const/4 v0, 0x0
    return v0
.end method
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    invoke-virtual \{([pv]\d+), ([pv]\d+)\}, Ljava/security/Signature;->verify\(\[B\)Z\n\n    move-result ([pv]\d+)
