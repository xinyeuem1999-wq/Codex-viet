# Combo: Check-Toàn-Vẹn+Mod-Shell (8 patch)

[MIN_ENGINE_VER]
3

[AUTHOR]
HTC 600

[PACKAGE]
*

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    .method public static(.+)\(Landroid/content/Context;\)I\n.*registers .+[\s\S]*?Google Play services missing.+[\s\S]*?end method
REGEX:
    true
REPLACE:
    .method public static${GROUP1}(Landroid/content/Context;)I
    .registers 1
    const/4 v0, 0x0
    return v0
.end method
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    invoke-virtual \{([pv]\d+), ([pv]\d+)\}, Ljava/security/Signature;->verify\(\[B\)Z\n\n    move-result ([pv]\d+)
REGEX:
    true
REPLACE:
    invoke-virtual {${GROUP1}, ${GROUP2}}, Ljava/security/Signature;->verify([B)Z

    const/4 ${GROUP3}, 0x1
[/MATCH_REPLACE]

[ADD_FILES]
TARGET:
    smali
EXTRACT:
    true
SOURCE:
    BiN.zip
[/ADD_FILES]

[MATCH_GOTO]
TARGET:
    AndroidManifest.xml
MATCH:
    <application(.+)android:name=
REGEX:
    true
GOTO:
    p1_app1
[/MATCH_GOTO]

[MATCH_REPLACE]
TARGET:
    AndroidManifest.xml
MATCH:
    <application(.+)>
REGEX:
    true
REPLACE:
    <application${GROUP1} android:name="cc.binmt.signature.PmsHookApplication">
[/MATCH_REPLACE]

[GOTO]
GOTO:
    p1_end
[/GOTO]

[MATCH_REPLACE]
NAME:
    p1_app1
TARGET:
    AndroidManifest.xml
MATCH:
    <application (.+) android:name="([^"]+)"(.+)
REGEX:
    true
REPLACE:
    <application ${GROUP1} android:name="cc.binmt.signature.PmsHookApplication"${GROUP3}
[/MATCH_REPLACE]

[MATCH_ASSIGN]
TARGET:
    [APPLICATION]
MATCH:
    \.class (.+?)L(.+);
REGEX:
    true
ASSIGN:
    LABEL_1=L${GROUP2};
[/MATCH_ASSIGN]

[MATCH_REPLACE]
TARGET:
    [APPLICATION]
MATCH:
    \.class public (|.+)L(.+);
REGEX:
    true
REPLACE:
    .class public L${GROUP2};
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    smali/cc/binmt/signature/PmsHookApplication.smali
MATCH:
    Landroid/app/Application;
REGEX:
    true
REPLACE:
    ${LABEL_1}
[/MATCH_REPLACE]

[EXECUTE_DEX]
NAME:
    p1_end
SCRIPT:
    sigfix.dex
SMALI_NEEDED:
    true
MAIN_CLASS:
    anymy.sign.BinSignatureFix
ENTRANCE:
    BinSignatureFix
PARAM:
    smali
[/EXECUTE_DEX]

[DUMMY]
NAME:
    p1_end2
[/DUMMY]

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    iget-object ([pv]\d+), ([pv]\d+), Landroid/content/pm/PackageInfo;->signatures:\[Landroid/content/pm/Signature;
REGEX:
    true
REPLACE:
    invoke-static {${GROUP2}}, Lapkeditor/patch/signature/Fix;->getSignatures(Landroid/content/pm/PackageInfo;)[Landroid/content/pm/Signature;
    move-result-object ${GROUP1}
[/MATCH_REPLACE]

[ADD_FILES]
SOURCE:
    Fix.smali
TARGET:
    smali/apkeditor/patch/signature/Fix.smali
[/ADD_FILES]

[SIGNATURE_REVISE]
TARGET:
    smali/apkeditor/patch/signature/Fix.smali
[/SIGNATURE_REVISE]

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    \.local .+|    \.line \d+|    \.prologue|    \.end local .+|    \.restart local .+|\.source .+
REGEX:
    true
REPLACE:
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    smali*/*smali
MATCH:
    const-string ([pv]\d+), ".+"\n\n    invoke-static \{([pv]\d+), ([pv]\d+)\}, Lcom/google/android/getGPS;->checkGPS\(Landroid/content/Context;Ljava/lang/String;\)V
REGEX:
    true
REPLACE:
    #  HTC 600 - ubivaet :-)
[/MATCH_REPLACE]

