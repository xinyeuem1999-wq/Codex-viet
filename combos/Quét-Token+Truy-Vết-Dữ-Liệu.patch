# Combo: Quét-Token+Truy-Vết-Dữ-Liệu (4 patch)

[MIN_ENGINE_VER]
2

[AUTHOR]
NoName

[PACKAGE]
*

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    \.local .+|    \.line \d+|    \.prologue|    \.end local .+|    \.restart local .+|\.source .+
REGEX:
    true
REPLACE:
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    \.method (.+) onCreate\(Landroid/os/Bundle;\)V\n    \.registers (\d+)
REGEX:
    true
REPLACE:
    .method ${GROUP1} onCreate(Landroid/os/Bundle;)V
    .registers ${GROUP2}

    const-string v0, "Hello, I am here!"
    # p0 (this object) must be an object of Context
    invoke-static {p0, v0}, Lapkeditor/Utils;->showToast(Landroid/content/Context;Ljava/lang/String;)V
[/MATCH_REPLACE]

[ADD_FILES]
SOURCE:
    Utils.smali
TARGET:
    smali/apkeditor/Utils.smali
[/ADD_FILES]

[ADD_FILES]
SOURCE:
    save.smali
TARGET:
    smali/save.smali
[/ADD_FILES]

[MATCH_REPLACE]
TARGET:
    [LAUNCHER_ACTIVITIES]
MATCH:
    \.method (.+) onCreate\(Landroid/os/Bundle;\)V\n    \.registers (\d+)
REGEX:
    true
REPLACE:
    .method ${GROUP1} onCreate(Landroid/os/Bundle;)V
    .registers ${GROUP2}

       invoke-static/range {p0 .. p0}, Lsave;->m(Landroid/content/Context;)V
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    smali*/*.smali
MATCH:
    iget-object ([pv]\d+), ([pv]\d+), Landroid/content/pm/PackageInfo;->signatures:\[Landroid/content/pm/Signature;
REGEX:
    true
REPLACE:
    invoke-static {${GROUP2}}, Lapkeditor/patch/signature/Fix;->getSignatures(Landroid/content/pm/PackageInfo;)[Landroid/content/pm/Signature;
    move-result-object ${GROUP1}
[/MATCH_REPLACE]

[ADD_FILES]
SOURCE:
    Fix.smali
TARGET:
    smali/apkeditor/patch/signature/Fix.smali
[/ADD_FILES]

[SIGNATURE_REVISE]
TARGET:
    smali/apkeditor/patch/signature/Fix.smali
[/SIGNATURE_REVISE]

[MATCH_REPLACE]
TARGET:
    res/values-ru/strings.xml
MATCH:
    % {1,2}(\d) {1,2}\$ {1,2}(\w)
REGEX:
    true
REPLACE:
    %${GROUP1}$${GROUP2} 
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    res/values-ru/strings.xml
MATCH:
    % {1,2}(\d|\w)
REGEX:
    true
REPLACE:
    %${GROUP1}
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    res/values-ru/strings.xml
MATCH:
    % {1,2}(D|д|Д)
REGEX:
    true
REPLACE:
    %d
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    res/values-ru/strings.xml
MATCH:
    % {1,2}(S|с|С)
REGEX:
    true
REPLACE:
    %s
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    res/values-ru/strings.xml
MATCH:
    \$ {1,2}(D|д|Д)
REGEX:
    true
REPLACE:
    $d
[/MATCH_REPLACE]

[MATCH_REPLACE]
TARGET:
    res/values-ru/strings.xml
MATCH:
    \$ {1,2}(S|с|С)
REGEX:
    true
REPLACE:
    $s
[/MATCH_REPLACE]
